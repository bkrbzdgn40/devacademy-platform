{
  "name": "devacademy-platform",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --dir apps/web dev",
    "build": "corepack pnpm --dir apps/web build",
    "lint": "corepack pnpm --dir apps/web lint",
